From d27714997a1fa8ced4db9b7f9779cb8dcc07e1b5 Mon Sep 17 00:00:00 2001
From: Loukious <24696530+Loukious@users.noreply.github.com>
Date: Mon, 23 Nov 2026 16:58:38 +0100
Subject: [PATCH] build: stop on errors and require compiled release artifacts

---
 build.sh | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/build.sh b/build.sh
index 169b1aacbc77561e5318be51d90979ff345b9e6f..85e146e6bb548acc9af96893668af1f344c44a05 100755
--- a/build.sh
+++ b/build.sh
@@ -1,4 +1,5 @@
 #!/bin/bash
+set -e
 KERNEL_DIR=$(pwd)
 CLANG="neutron"
 TC_DIR="$HOME/toolchains/$CLANG-clang"
@@ -103,6 +104,10 @@ mkdir -p $HOME/vayu/kernel-out
 make $PROC "${MAKE_PARAMS[@]}" $DEFCONFIG 
 echo -e "\nStarting compilation...\n"
 make $PROC "${MAKE_PARAMS[@]}"
+if [ ! -s "$OUT/arch/arm64/boot/Image" ]; then
+    echo "ERROR: kernel Image was not produced; refusing to package a release." >&2
+    exit 1
+fi
 
 # Creating zip flashable file
 function create_zip {
@@ -129,5 +134,6 @@ if [ -f "$OUT/arch/arm64/boot/Image" ]; then
 	create_zip
 	echo -e "\nDone !"
 else
-	echo -e "\nFailed!"
+	echo "ERROR: kernel Image missing after compilation." >&2
+	exit 1
 fi
-- 
2.53.0

